# Server-only keys: configure on Vercel Production and Preview, then redeploy.
TICKETMASTER_API_KEY=
OPENAI_API_KEY=
# Optional model override (must support Responses function calling).
OPENAI_MODEL=gpt-4.1-mini

# Vite development proxy target; also set this on Vercel for its Plans proxy.
PLANS_API_URL=http://127.0.0.1:3001
# Optional direct browser-to-API origin (the API must allow the frontend origin).
# VITE_PLANS_API_URL=https://your-plans-api.example.com
